{
  "seed": 42,
  "device": "cuda",
  "precision": "bf16",
  "threads": 2,
  "data_dir": "build/everyday-v11-data",
  "allow_auto_aligned": true,
  "steps": 2500,
  "batch_size": 128,
  "log_every": 250,
  "learning_rate": 0.0002,
  "select_best_validation": true,
  "early_stopping_patience": 5,
  "validation_min_delta": 0.0001,
  "balance_difficulties": true,
  "weight_decay": 0.1,
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 384,
    "max_seq_len": 64,
    "dropout": 0.1
  },
  "lr_schedule": "cosine",
  "warmup_steps": 100,
  "min_lr_ratio": 0.1,
  "train_loss_samples": 2048,
  "corpus_mixture": {
    "tatoeba": 0.1,
    "teacher": 0.55,
    "everyday": 0.3,
    "paired": 0.05
  },
  "validation_corpus_mixture": {
    "tatoeba": 0.1,
    "teacher": 0.55,
    "everyday": 0.3,
    "paired": 0.05
  },
  "checkpoint": "build/checkpoints/everyday-v11-quality.pt",
  "initialize_from": "build/everyday-v11-data/ce-initialization.pt"
}
