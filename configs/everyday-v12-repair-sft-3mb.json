{
  "seed": 42,
  "device": "cuda",
  "precision": "bf16",
  "threads": 2,
  "data_dir": "build/everyday-v11-data",
  "allow_auto_aligned": true,
  "steps": 600,
  "batch_size": 128,
  "log_every": 100,
  "learning_rate": 5e-05,
  "select_best_validation": false,
  "early_stopping_patience": 0,
  "validation_min_delta": 0.0001,
  "balance_difficulties": true,
  "weight_decay": 0.1,
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 384,
    "max_seq_len": 64,
    "dropout": 0.1
  },
  "lr_schedule": "cosine",
  "warmup_steps": 30,
  "min_lr_ratio": 0.1,
  "train_loss_samples": 2048,
  "corpus_mixture": {
    "tatoeba": 0.1,
    "teacher": 0.55,
    "everyday": 0.3,
    "paired": 0.05
  },
  "validation_corpus_mixture": {
    "tatoeba": 0.1,
    "teacher": 0.55,
    "everyday": 0.3,
    "paired": 0.05
  },
  "checkpoint": "build/checkpoints/everyday-v12-repair-sft.pt",
  "initialize_from": "build/everyday-v11-data/quality-initialization.pt",
  "allow_model_reviewed_repairs": true,
  "repair_auxiliary": {
    "data_dir": "build/everyday-v12-repairs-reviewed",
    "positive_weight": 0.3,
    "negative_weight": 0,
    "batch_size": 32
  }
}
