{
  "seed": 42,
  "device": "cuda",
  "threads": 2,
  "data_dir": "build/stories-v2-data",
  "allow_auto_aligned": true,
  "checkpoint": "build/checkpoints/stories-v2-diverse-3mb.pt",
  "steps": 10000,
  "batch_size": 128,
  "log_every": 500,
  "learning_rate": 0.001,
  "select_best_validation": true,
  "early_stopping_patience": 5,
  "validation_min_delta": 0.0001,
  "balance_difficulties": true,
  "label_smoothing": 0.02,
  "weight_decay": 0.1,
  "noun_context_dropout": 0.1,
  "model": {
    "d_model": 224,
    "n_heads": 8,
    "n_layers": 4,
    "d_ff": 672,
    "max_seq_len": 64,
    "dropout": 0.1
  },
  "lr_schedule": "cosine",
  "warmup_steps": 200,
  "min_lr_ratio": 0.1,
  "train_loss_samples": 2048,
  "lexical_balance": {
    "strength": 0.5,
    "max_ratio": 3.0
  },
  "require_generation_eligible": true
}
